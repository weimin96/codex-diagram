flowchart TB
  A([提交订单]) --> B{参数有效?}
  B -- 否 --> X1([返回参数错误])
  B -- 是 --> C[加载用户与购物车]
  C --> D{库存充足?}
  D -- 否 --> X2([返回库存不足])
  D -- 是 --> E[锁定库存]
  E --> F{优惠可用?}
  F -- 是 --> G[计算优惠]
  F -- 否 --> H[使用原价]
  G --> I[计算应付金额]
  H --> I
  I --> J{需要人工风控?}
  J -- 是 --> K[进入风控审核]
  K --> L{审核通过?}
  L -- 否 --> X3([拒绝订单])
  L -- 是 --> M[创建待支付订单]
  J -- 否 --> M
  M --> N[请求支付]
  N --> O{支付成功?}
  O -- 是 --> P[确认库存扣减]
  P --> Q[发送 OrderPaid]
  Q --> R[生成履约任务]
  R --> S([订单完成])
  O -- 否 --> T{重试次数 < 3?}
  T -- 是 --> U[记录失败并重试]
  U --> N
  T -- 否 --> V[释放库存]
  V --> X4([支付失败])
