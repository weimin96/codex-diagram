{
  "name": "codex-diagram",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "Visual diagram workspace for Codex with Mermaid editing and MCP tools.",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "plugin:install": "pnpm build && node scripts/install-codex-plugin.mjs",
    "plugin:install:desktop": "pnpm plugin:install && node scripts/reload-codex-desktop.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/mcp-extensions": "^0.1.0",
    "mermaid": "^11.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
