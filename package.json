{
  "name": "codex-diagram",
  "version": "0.19.0",
  "private": true,
  "type": "module",
  "description": "Visual diagram workspace for Codex with Mermaid editing and MCP tools.",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "visual:smoke": "node scripts/visual-smoke.mjs",
    "visual:benchmark": "node scripts/visual-smoke.mjs --source-dir tests/fixtures/visual-stress --quality-benchmark",
    "visual:regression": "node scripts/visual-regression.mjs",
    "visual:regression:update": "node scripts/visual-regression.mjs --update",
    "visual:verify": "pnpm visual:smoke && pnpm visual:benchmark && pnpm visual:regression",
    "plugin:install": "pnpm build && node scripts/install-codex-plugin.mjs",
    "plugin:install:desktop": "pnpm plugin:install && node scripts/reload-codex-desktop.mjs"
  },
  "dependencies": {
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@lezer/highlight": "^1.2.1",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/mcp-extensions": "^0.1.0",
    "codemirror": "^6.0.2",
    "mermaid": "^11.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-icons": "^16.34.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
